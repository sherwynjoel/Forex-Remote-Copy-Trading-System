generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MasterStatus {
  ACTIVE
  DISABLED
}

enum SlaveStatus {
  ONLINE
  OFFLINE
  CONNECTING
  ERROR
  DISABLED
}

enum ConnectorStatus {
  ONLINE
  OFFLINE
  CONNECTING
  ERROR
}

enum TradeEventType {
  OPEN
  CLOSE
  MODIFY
  PARTIAL_CLOSE
  PENDING_OPEN
  PENDING_MODIFY
  PENDING_CANCEL
}

enum TradeSide {
  BUY
  SELL
}

enum CopyOrderStatus {
  PENDING
  SENT
  EXECUTED
  FAILED
  REJECTED
}

model Master {
  id            String       @id @default(uuid())
  name          String
  accountNumber String       @unique @map("account_number")
  broker        String
  platform      String       @default("MT5")
  server        String
  status        MasterStatus @default(ACTIVE)
  createdAt     DateTime     @default(now()) @map("created_at")

  connectors  Connector[]
  tradeEvents TradeEvent[]
  slaves      Slave[]
  copyOrders  CopyOrder[]

  @@map("masters")
}

model Slave {
  id            String      @id @default(uuid())
  masterId      String      @map("master_id")
  master        Master      @relation(fields: [masterId], references: [id])
  name          String
  accountNumber String      @unique @map("account_number")
  broker        String
  platform      String      @default("MT5")
  server        String
  status        SlaveStatus @default(CONNECTING)
  copyEnabled   Boolean     @default(true) @map("copy_enabled")
  createdAt     DateTime    @default(now()) @map("created_at")

  connectors Connector[]
  copyOrders CopyOrder[]

  @@index([masterId])
  @@map("slaves")
}

// A connector is either bound to a Master (the MQL5 EA, Phase 1) or a Slave
// (the Python service, Phase 2) — never both. Sharing one table/auth path
// avoids duplicating the identical register/authenticate/heartbeat logic.
model Connector {
  id              String          @id @default(uuid())
  masterId        String?         @map("master_id")
  master          Master?         @relation(fields: [masterId], references: [id])
  slaveId         String?         @map("slave_id")
  slave           Slave?          @relation(fields: [slaveId], references: [id])
  tokenHash       String          @unique @map("token_hash")
  version         String?
  status          ConnectorStatus @default(CONNECTING)
  lastHeartbeatAt DateTime?       @map("last_heartbeat_at")
  createdAt       DateTime        @default(now()) @map("created_at")

  @@index([masterId])
  @@index([slaveId])
  @@map("connectors")
}

model TradeEvent {
  id                  String         @id @default(uuid())
  eventId             String         @unique @map("event_id")
  masterId            String         @map("master_id")
  master              Master         @relation(fields: [masterId], references: [id])
  masterTicket        String         @map("master_ticket")
  type                TradeEventType
  symbol              String
  side                TradeSide?
  volume              Decimal?       @db.Decimal(18, 2)
  price               Decimal?       @db.Decimal(18, 5)
  sl                  Decimal?       @db.Decimal(18, 5)
  tp                  Decimal?       @db.Decimal(18, 5)
  rawPayload          Json           @map("raw_payload")
  masterEventTime     DateTime       @map("master_event_time")
  eaSentTime          DateTime       @map("ea_sent_time")
  backendReceivedTime DateTime       @map("backend_received_time")
  createdAt           DateTime       @default(now()) @map("created_at")

  copyOrders CopyOrder[]

  @@index([masterId])
  @@index([masterTicket])
  @@index([createdAt])
  @@map("trade_events")
}

// One row per (trade_event, slave) — CLOSE and MODIFY get their own row,
// not just OPEN, so each copy action is tracked with its own status/latency
// (mirrors the spec's Trade Monitoring table). Resolving which slave ticket
// a CLOSE/MODIFY acts on is a lookup by (slaveId, masterTicket, type=OPEN,
// status=EXECUTED) — see copy-engine module.
model CopyOrder {
  id              String          @id @default(uuid())
  tradeEventId    String          @map("trade_event_id")
  tradeEvent      TradeEvent      @relation(fields: [tradeEventId], references: [id])
  masterId        String          @map("master_id")
  master          Master          @relation(fields: [masterId], references: [id])
  slaveId         String          @map("slave_id")
  slave           Slave           @relation(fields: [slaveId], references: [id])
  masterTicket    String          @map("master_ticket")
  type            TradeEventType
  status          CopyOrderStatus @default(PENDING)
  requestedVolume Decimal?        @map("requested_volume") @db.Decimal(18, 2)
  slaveTicket     String?         @map("slave_ticket")
  executionPrice  Decimal?        @map("execution_price") @db.Decimal(18, 5)
  errorReason     String?         @map("error_reason")
  sentAt          DateTime?       @map("sent_at")
  executedAt      DateTime?       @map("executed_at")
  createdAt       DateTime        @default(now()) @map("created_at")

  @@unique([tradeEventId, slaveId])
  @@index([slaveId, masterTicket, status])
  @@index([masterId])
  @@map("copy_orders")
}

model AuditLog {
  id        String   @id @default(uuid())
  actor     String
  action    String
  entity    String
  oldValue  Json?    @map("old_value")
  newValue  Json?    @map("new_value")
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}
