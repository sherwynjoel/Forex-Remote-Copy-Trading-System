generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MasterStatus {
  ACTIVE
  DISABLED
}

enum SlaveStatus {
  ONLINE
  OFFLINE
  CONNECTING
  ERROR
  DISABLED
}

enum ConnectorStatus {
  ONLINE
  OFFLINE
  CONNECTING
  ERROR
}

enum TradeEventType {
  OPEN
  CLOSE
  MODIFY
  PARTIAL_CLOSE
  PENDING_OPEN
  PENDING_MODIFY
  PENDING_CANCEL
}

enum TradeSide {
  BUY
  SELL
}

enum CopyOrderStatus {
  PENDING
  SENT
  EXECUTED
  FAILED
  REJECTED
}

// Fixed lot, multiplier, and balance/equity-proportional sizing — see
// modules/copy-engine/volumeCalculator.ts. Percentage-risk sizing is
// deliberately deferred (out of this phase's scope).
enum CopyMode {
  FIXED_LOT
  MULTIPLIER
  BALANCE_PROPORTIONAL
  EQUITY_PROPORTIONAL
}

// A single Super Admin credential for now — no multi-user/RBAC yet (spec
// section 30 describes multiple roles; deferred until there's an actual
// need for more than one operator). See modules/auth/auth.service.ts.
model Admin {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("admins")
}

model Master {
  id            String       @id @default(uuid())
  name          String
  accountNumber String       @unique @map("account_number")
  broker        String
  platform      String       @default("MT5")
  server        String
  status        MasterStatus @default(ACTIVE)
  // Updated from the Master EA's heartbeat; needed for
  // BALANCE_PROPORTIONAL / EQUITY_PROPORTIONAL sizing on its Slaves.
  balance       Decimal?     @map("balance") @db.Decimal(18, 2)
  equity        Decimal?     @map("equity") @db.Decimal(18, 2)
  // Current open positions as last reported by the EA's heartbeat — the
  // "Master state" side of reconciliation (spec section 21). See
  // modules/reconciliation/reconciliationEngine.ts.
  positionSnapshot   Json?     @map("position_snapshot")
  positionSnapshotAt DateTime? @map("position_snapshot_at")
  createdAt     DateTime     @default(now()) @map("created_at")

  connectors             Connector[]
  tradeEvents            TradeEvent[]
  slaves                 Slave[]
  copyOrders             CopyOrder[]
  reconciliationFindings ReconciliationFinding[]

  @@map("masters")
}

model Slave {
  id            String      @id @default(uuid())
  masterId      String      @map("master_id")
  master        Master      @relation(fields: [masterId], references: [id])
  name          String
  accountNumber String      @unique @map("account_number")
  broker        String
  platform      String      @default("MT5")
  server        String
  status        SlaveStatus @default(CONNECTING)
  copyEnabled   Boolean     @default(true) @map("copy_enabled")

  // Volume Calculator configuration (spec section 13) — see
  // modules/copy-engine/volumeCalculator.ts for how these are applied.
  copyMode   CopyMode @default(MULTIPLIER) @map("copy_mode")
  fixedLot   Decimal? @map("fixed_lot") @db.Decimal(18, 2)
  multiplier Decimal  @default(1.0) @map("multiplier") @db.Decimal(10, 4)
  minLot     Decimal  @default(0.01) @map("min_lot") @db.Decimal(18, 2)
  maxLot     Decimal  @default(10.0) @map("max_lot") @db.Decimal(18, 2)
  lotStep    Decimal  @default(0.01) @map("lot_step") @db.Decimal(18, 2)

  // Updated from this Slave's connector heartbeat.
  balance Decimal? @map("balance") @db.Decimal(18, 2)
  equity  Decimal? @map("equity") @db.Decimal(18, 2)
  // Current open positions as last reported by the Slave service's
  // heartbeat — the "Slave state" side of reconciliation. Each item
  // carries the MT5 order comment (copy:<copyId>), which is how
  // reconciliation traces a Slave position back to the copy that created
  // it. See modules/reconciliation/reconciliationEngine.ts.
  positionSnapshot   Json?     @map("position_snapshot")
  positionSnapshotAt DateTime? @map("position_snapshot_at")

  // Risk limits (spec section 15) — all default to "off / no restriction"
  // since these are opt-in guardrails, not always-on caps like maxLot
  // above. Enforced only on OPEN; see modules/copy-engine/riskChecks.ts.
  // Max daily loss / max drawdown are deferred (need equity-history
  // tracking this system doesn't have yet).
  emergencyStop  Boolean  @default(false) @map("emergency_stop")
  allowedSymbols String[] @default([]) @map("allowed_symbols")
  blockedSymbols String[] @default([]) @map("blocked_symbols")
  maxPositions   Int?     @map("max_positions")
  maxExposure    Decimal? @map("max_exposure") @db.Decimal(18, 2)

  createdAt DateTime @default(now()) @map("created_at")

  connectors             Connector[]
  copyOrders             CopyOrder[]
  symbolMappings         SymbolMapping[]
  reconciliationFindings ReconciliationFinding[]

  @@index([masterId])
  @@map("slaves")
}

// Per-Slave Master-symbol -> Slave-symbol translation (spec section 14),
// e.g. XAUUSD -> XAUUSDm for a broker with a different suffix convention.
// Falls back to the Master's symbol unchanged when no mapping exists — see
// modules/slaves/symbolMapping.service.ts.
model SymbolMapping {
  id           String   @id @default(uuid())
  slaveId      String   @map("slave_id")
  slave        Slave    @relation(fields: [slaveId], references: [id])
  masterSymbol String   @map("master_symbol")
  slaveSymbol  String   @map("slave_symbol")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([slaveId, masterSymbol])
  @@map("symbol_mappings")
}

// A connector is either bound to a Master (the MQL5 EA, Phase 1) or a Slave
// (the Python service, Phase 2) — never both. Sharing one table/auth path
// avoids duplicating the identical register/authenticate/heartbeat logic.
model Connector {
  id              String          @id @default(uuid())
  masterId        String?         @map("master_id")
  master          Master?         @relation(fields: [masterId], references: [id])
  slaveId         String?         @map("slave_id")
  slave           Slave?          @relation(fields: [slaveId], references: [id])
  tokenHash       String          @unique @map("token_hash")
  version         String?
  status          ConnectorStatus @default(CONNECTING)
  lastHeartbeatAt DateTime?       @map("last_heartbeat_at")
  createdAt       DateTime        @default(now()) @map("created_at")

  @@index([masterId])
  @@index([slaveId])
  @@map("connectors")
}

model TradeEvent {
  id                  String         @id @default(uuid())
  eventId             String         @unique @map("event_id")
  masterId            String         @map("master_id")
  master              Master         @relation(fields: [masterId], references: [id])
  masterTicket        String         @map("master_ticket")
  type                TradeEventType
  symbol              String
  side                TradeSide?
  volume              Decimal?       @db.Decimal(18, 2)
  price               Decimal?       @db.Decimal(18, 5)
  sl                  Decimal?       @db.Decimal(18, 5)
  tp                  Decimal?       @db.Decimal(18, 5)
  rawPayload          Json           @map("raw_payload")
  masterEventTime     DateTime       @map("master_event_time")
  eaSentTime          DateTime       @map("ea_sent_time")
  backendReceivedTime DateTime       @map("backend_received_time")
  // Computed in ingest.routes.ts (see monitoring/latency.ts) at ingest
  // time; stored so the dashboard's "AVG LATENCY" card has real data to
  // query instead of only ever appearing in logs.
  detectionLatencyMs Int? @map("detection_latency_ms")
  networkLatencyMs   Int? @map("network_latency_ms")
  totalLatencyMs     Int? @map("total_latency_ms")
  createdAt           DateTime       @default(now()) @map("created_at")

  copyOrders CopyOrder[]

  @@index([masterId])
  @@index([masterTicket])
  @@index([createdAt])
  @@map("trade_events")
}

// One row per (trade_event, slave) — CLOSE and MODIFY get their own row,
// not just OPEN, so each copy action is tracked with its own status/latency
// (mirrors the spec's Trade Monitoring table). Resolving which slave ticket
// a CLOSE/MODIFY acts on is a lookup by (slaveId, masterTicket, type=OPEN,
// status=EXECUTED) — see copy-engine module.
model CopyOrder {
  id              String          @id @default(uuid())
  tradeEventId    String          @map("trade_event_id")
  tradeEvent      TradeEvent      @relation(fields: [tradeEventId], references: [id])
  masterId        String          @map("master_id")
  master          Master          @relation(fields: [masterId], references: [id])
  slaveId         String          @map("slave_id")
  slave           Slave           @relation(fields: [slaveId], references: [id])
  masterTicket    String          @map("master_ticket")
  type            TradeEventType
  status          CopyOrderStatus @default(PENDING)
  requestedVolume Decimal?        @map("requested_volume") @db.Decimal(18, 2)
  slaveTicket     String?         @map("slave_ticket")
  executionPrice  Decimal?        @map("execution_price") @db.Decimal(18, 5)
  errorReason     String?         @map("error_reason")
  sentAt          DateTime?       @map("sent_at")
  executedAt      DateTime?       @map("executed_at")
  createdAt       DateTime        @default(now()) @map("created_at")

  @@unique([tradeEventId, slaveId])
  @@index([slaveId, masterTicket, status])
  @@index([masterId])
  @@map("copy_orders")
}

enum ReconciliationFindingType {
  MISSING_COPY
  SLAVE_POSITION_MISSING
  VOLUME_MISMATCH
  SLTP_MISMATCH
  SLAVE_NOT_CLOSED
  UNEXPECTED_SLAVE_POSITION
  DUPLICATE_SLAVE_POSITION
}

// Represents *current* known desync issues for a (Master, Slave) pair —
// each reconciliation run replaces a pair's findings rather than
// appending to history (spec section 21's "show this immediately to the
// administrator" wants current status, not an ever-growing log; a
// historical trend view is a later, separate concern). See
// modules/reconciliation/reconciliationEngine.ts.
model ReconciliationFinding {
  id           String                    @id @default(uuid())
  masterId     String                    @map("master_id")
  master       Master                    @relation(fields: [masterId], references: [id])
  slaveId      String                    @map("slave_id")
  slave        Slave                     @relation(fields: [slaveId], references: [id])
  type         ReconciliationFindingType
  masterTicket String?                   @map("master_ticket")
  slaveTicket  String?                   @map("slave_ticket")
  details      Json
  detectedAt   DateTime                  @default(now()) @map("detected_at")

  @@index([masterId])
  @@index([slaveId])
  @@map("reconciliation_findings")
}

model AuditLog {
  id        String   @id @default(uuid())
  actor     String
  action    String
  entity    String
  oldValue  Json?    @map("old_value")
  newValue  Json?    @map("new_value")
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}
