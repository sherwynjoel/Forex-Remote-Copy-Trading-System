DATABASE_URL="postgresql://forex:forex@localhost:5433/forex_copy?schema=public"
REDIS_URL="redis://localhost:6379"
PORT=4000
LOG_LEVEL=info

# Idempotency key TTL for de-duplicating trade events, in seconds
EVENT_IDEMPOTENCY_TTL_SECONDS=86400

# How long before a connector with no heartbeat is considered OFFLINE, in seconds
CONNECTOR_OFFLINE_THRESHOLD_SECONDS=15

# How often the Reconciliation Engine compares Master/system/Slave state, in seconds
RECONCILIATION_INTERVAL_SECONDS=60

# A position snapshot older than this is skipped instead of compared, to
# avoid false findings from a disconnected connector's stale last-known state
RECONCILIATION_STALENESS_SECONDS=30

# Tolerance before a volume/price difference counts as a mismatch
RECONCILIATION_VOLUME_TOLERANCE=0.01
RECONCILIATION_PRICE_TOLERANCE=0.0001

# Super Admin auth. CHANGE ALL OF THESE for anything beyond local dev --
# the defaults are intentionally well-known/insecure.
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRES_IN=12h
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Origin the dashboard frontend is served from (browser CORS)
CORS_ORIGIN=http://localhost:5173
