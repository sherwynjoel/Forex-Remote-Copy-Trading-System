DATABASE_URL="postgresql://forex:forex@localhost:5433/forex_copy?schema=public"
REDIS_URL="redis://localhost:6379"
PORT=4000
LOG_LEVEL=info

# Idempotency key TTL for de-duplicating trade events, in seconds
EVENT_IDEMPOTENCY_TTL_SECONDS=86400

# How long before a connector with no heartbeat is considered OFFLINE, in seconds
CONNECTOR_OFFLINE_THRESHOLD_SECONDS=15
