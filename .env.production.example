# Copy this to .env.production and fill in real values before running
# docker-compose.prod.yml. This file is read two ways: docker compose
# itself substitutes the POSTGRES_*/DOMAIN vars into the compose file
# (via --env-file, see docs/DEPLOYMENT.md), and the whole file is also
# passed straight into the backend container's environment (env_file:).
#
# NEVER commit the real .env.production — it holds production secrets.
# (.gitignore already excludes it.)

# --- Postgres ---
# Used both to configure the postgres container itself and inside
# DATABASE_URL below — keep these three values consistent with the
# DATABASE_URL line, since compose does not reliably expand ${} inside an
# env_file the same way it does inside the compose file itself.
POSTGRES_USER=forex
POSTGRES_PASSWORD=REPLACE_WITH_A_REAL_RANDOM_PASSWORD
POSTGRES_DB=forex_copy

# --- Backend ---
# "postgres" and "redis" below are the other containers' service names —
# Docker Compose resolves them as hostnames on the internal network, not
# localhost, since this all runs inside containers, not on the host.
DATABASE_URL=postgresql://forex:REPLACE_WITH_A_REAL_RANDOM_PASSWORD@postgres:5432/forex_copy?schema=public
REDIS_URL=redis://redis:6379
PORT=4000
LOG_LEVEL=info

EVENT_IDEMPOTENCY_TTL_SECONDS=86400
CONNECTOR_OFFLINE_THRESHOLD_SECONDS=15
RECONCILIATION_INTERVAL_SECONDS=60
RECONCILIATION_STALENESS_SECONDS=30
RECONCILIATION_VOLUME_TOLERANCE=0.01
RECONCILIATION_PRICE_TOLERANCE=0.0001

# Generate with: openssl rand -hex 32 — do not reuse the dev default.
JWT_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
JWT_EXPIRES_IN=12h
ADMIN_USERNAME=REPLACE_WITH_A_REAL_USERNAME
# Not "admin" — this is a real credential protecting live trading control.
ADMIN_PASSWORD=REPLACE_WITH_A_REAL_STRONG_PASSWORD

# The origin the dashboard is actually served from. With the Caddyfile as
# shipped (frontend + API on one domain), this is just https://DOMAIN.
CORS_ORIGIN=https://REPLACE_WITH_YOUR_DOMAIN

# --- Caddy ---
# A real domain with its DNS A/AAAA record already pointed at this VPS's
# IP — Caddy uses this both to request the Let's Encrypt certificate and
# to know which Host header to serve. A bare IP or "localhost" here
# disables automatic HTTPS.
DOMAIN=REPLACE_WITH_YOUR_DOMAIN
